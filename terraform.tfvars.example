aws_region           = "us-east-1"
project_prefix       = "northline"
environment          = "prod"
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
ecs_desired_count    = 2
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
container_image_tag  = "latest"
alarm_email          = ""

# Required — ACM certificate in the same region as aws_region
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Sandbox defaults (override for real prod)
skip_final_snapshot = true
deletion_protection = false
