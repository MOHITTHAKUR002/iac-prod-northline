aws_region           = "us-east-1"
project_prefix       = "northline"
environment          = "prod"
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
ecs_desired_count    = 2
ecs_max_capacity     = 4
fargate_base         = 1
fargate_weight       = 1
fargate_spot_weight  = 3
container_port       = 8080
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
container_image_tag  = "latest"
alarm_email          = ""

# Required — ACM certificate in the same region as aws_region
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Production defaults (skip_final_snapshot=false, deletion_protection=true in variables.tf).
# For sandbox teardown only, override:
# skip_final_snapshot = true
# deletion_protection = false
